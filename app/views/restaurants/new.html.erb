<div class="container">
  <h1>New Restaurant</h1>

  <div class="card p-4">
    <%= form_with model: @restaurant, url: restaurants_path, local: true, data: { turbo: false } do |form| %>
      <div class="mb-3">
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :address, class: "form-label" %>
        <%= form.text_field :address, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :category, class: "form-label" %>
        <%= form.text_field :category, class: "form-control" %>
      </div>

      <%= form.submit "Create Restaurant", class: "btn btn-success" %>
    <% end %>
  </div>

  <div class="mt-3">
    <%= link_to "Back to Restaurants", restaurants_path, class: "btn btn-secondary" %>
  </div>
</div>
