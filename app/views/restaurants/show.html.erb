<div class="container">
  <h1><%= @restaurant.name %></h1>

  <div class="card p-4">
    <img src="https://source.unsplash.com/600x400/?restaurant,dining" alt="Restaurant Image">
    <p class="mt-3"><strong>Address:</strong> <%= @restaurant.address %></p>
    <p><strong>Category:</strong> <%= @restaurant.category %></p>

    <%= link_to "Back to Restaurants", restaurants_path, class: "btn btn-secondary" %>
  </div>
</div>
