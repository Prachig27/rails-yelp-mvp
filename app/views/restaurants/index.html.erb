<h1 class="text-center">Restaurants</h1>

<div class="text-center mb-3">
  <%= link_to "Create New Restaurant", new_restaurant_path, class: "btn btn-primary" %>
</div>

<div class="row">
  <% @restaurants.each do |restaurant| %>
    <div class="col-md-4">
      <div class="card mb-4">
        <img src="https://loremflickr.com/320/240" />
        <div class="card-body">
          <h5 class="card-title"><%= restaurant.name %></h5>
          <p class="card-text"><%= restaurant.address %></p>
          <p class="card-text"><strong>Category:</strong> <%= restaurant.category %></p>
          <%= link_to "View Details", restaurant_path(restaurant), class: "btn btn-outline-dark btn-sm" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
